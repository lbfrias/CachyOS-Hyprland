[
    {
        "output": "DP-1",
        "name": "main",
        "layer": "top",
        "position": "top",
        "height": 30,
        "width": 0,
        "margin": 0,
        "reload_style_on_change": true,
        "modules-center": [
            "hyprland/workspaces",
            "hyprland/workspaces#special",
            "tray",
            "pulseaudio",
            "pulseaudio#source",
            "bluetooth",
            "clock",
            "custom/power",
        ],
        "hyprland/workspaces": {
            "format": "{name}",
            "active-only": false,
            "all-outputs": false,
            "persistent-workspaces": {
                "DP-1": [
                    1,2,3
                ],
                "DP-2": [
                    "name:chat"
                ],
                "DP-3": [
                    "name:homeassistant"
                ]
            }
        },
        "hyprland/workspaces#special": {
            "format": "{icon}",
            "format-icons": {
                "default": "",
                "spotify": "",
                "steam": "",
                "game": "󰊴"
            },
            "active-only": false,
            "all-outputs": false,
            "show-special": true,
            "ignore-workspaces": [
                "\\d+"
            ]
        },
        "clock": {
            "interval": 1,
            "format": "{:%a %b %d %H:%M:%S}",
            "tooltip": false
        },
        "bluetooth": {
            "format": "{icon}",
            "format-connected": "{icon} {num_connections}",
            "format-on": "{icon}",
            "format-off": "{icon}",
            "format-disabled": "{icon}",
            "format-icons": {
                "disabled": "󰂲",
                "off": "󰂲",
                "on": "󰂯",
                "connected": "󰂱"
            },
            "on-click": "(pgrep -i blueman-manager && pkill -i blueman-manager) || blueman-manager",
            "tooltip-format": "{controller_alias}\t{controller_address}",
            "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
            "tooltip-format-enumerate-connected": "{device_alias}\t",
            "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%"
        },
        "pulseaudio": {
            "format": "{icon} {volume}%",
            "format-icons": {
                "default": [
                    "",
                    "",
                    ""
                ],
                "default-muted": "",
                "headphone": "",
                "headphone-muted": "󰟎"
            },
            "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
            "on-click-right": "pavucontrol -t 3"
        },
        "pulseaudio#source": {
            "format": "{format_source}",
            "format-source": "",
            "format-source-muted": "",
            "on-click": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
            "on-click-right": "pavucontrol -t 4",
            "target": "source",
            "tooltip-format": "{source_desc}"

        },
        "custom/power": {
            "format": "⏻",
            "tooltip": false,
            "menu": "on-click",
            "menu-file": "~/.config/waybar/power_menu.xml",
            "menu-actions": {
                "shutdown": "shutdown now",
                "reboot": "reboot",
                "suspend": "systemctl suspend",
                "lock": "hyprlock",
                "hibernate": "systemctl hibernate"
            }
        },
    },
